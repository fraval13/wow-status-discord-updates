# Only needed by the service when --discord is supplied. Never commit real values.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# No OpenAI key is required or read by this version.

# ID-only group mode. Exact text entered in WoW; separate service/database per group.
DISCORD_GROUP_NAME="Weekend Crew"
# For the optional multi-instance systemd template:
WOW_STATUS_PORT=8081
