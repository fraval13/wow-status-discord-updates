# Production gateway, installed at /etc/caddy/Caddyfile on 193.243.189.202.
# Group names are shared secrets, so their routes are not in Git:
# deploy/render_caddyfile.py renders this template with one route per group from
# the server's private /etc/wow-character-status/groups.json. Never commit the result.
# Root maintenance installs/validates/reloads it; application releases do not.
# No access logs: URLs and request credentials must not be recorded.
wow.frankvalde.com {
    request_body {
        max_size 256000
    }
    # GROUP ROUTES
    handle /groups/* {
        respond "Unknown group" 404
    }
    handle {
        root * /srv/wow-status-homepage/current
        encode zstd gzip
        header {
            X-Content-Type-Options nosniff
            Referrer-Policy strict-origin-when-cross-origin
            Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
            Cache-Control "no-cache"
        }
        @download path /downloads/*.zip
        header @download Content-Disposition "attachment"
        file_server
    }
}
