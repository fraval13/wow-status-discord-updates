[Unit]
Description=WoW character status ingestion and Discord bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wow-status
Group=wow-status
WorkingDirectory=/opt/wow-status
EnvironmentFile=/etc/wow-status.env
ExecStart=/opt/wow-status/.venv/bin/wow-status serve --db /var/lib/wow-status/service.sqlite3 --discord
Restart=on-failure
RestartSec=10
StateDirectory=wow-status
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wow-status

[Install]
WantedBy=multi-user.target
