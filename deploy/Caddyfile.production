# Installed at /etc/caddy/Caddyfile on 193.243.189.202.
# Root maintenance installs/validates/reloads this; application releases do not.
# No access logs: URLs and request credentials must not be recorded.
wow.frankvalde.com {
    request_body {
        max_size 256000
    }
    handle_path /groups/19e32befc180a1cfdea5c3/* {
        reverse_proxy 127.0.0.1:18081 {
            header_up X-WoW-Client-IP {http.request.remote.host}
        }
    }
    handle_path /groups/466f79683c7465bc3a5ba0/* {
        reverse_proxy 127.0.0.1:18082 {
            header_up X-WoW-Client-IP {http.request.remote.host}
        }
    }
    handle /groups/* {
        respond "Unknown group" 404
    }
    handle {
        root * /srv/wow-status-homepage/current
        encode zstd gzip
        header {
            X-Content-Type-Options nosniff
            Referrer-Policy strict-origin-when-cross-origin
            Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
            Cache-Control "no-cache"
        }
        @download path /downloads/*.zip
        header @download Content-Disposition "attachment"
        file_server
    }
}
