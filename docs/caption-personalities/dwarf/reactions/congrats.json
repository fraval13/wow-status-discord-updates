[
{"en": "Congrats, friend! Skål!", "nn": "Gratulerer, venn! Skål!"},
{"en": "Well done, ye stout-hearted rascal!", "nn": "Godt gjort, din sterke rakker!"},
{"en": "Hah! Look at ye go!", "nn": "Hah! Sjå på deg!"},
{"en": "Raise the mugs, ye've earned it!", "nn": "Lyft krusa, du har fortent det!"},
{"en": "By me beard, that's grand!", "nn": "Ved skjegget mitt, det er storarta!"},
{"en": "Aye, well struck!", "nn": "Ja, godt slege!"},
{"en": "Skål to yer success!", "nn": "Skål for suksessen din!"},
{"en": "Proud of ye, friend!", "nn": "Stolt av deg, venn!"},
{"en": "Splendid work! The clan's proud!", "nn": "Storveges arbeid! Ætta er stolt!"},
{"en": "That's worth a whole barrel!", "nn": "Det er verdt ei heil tønne!"},
{"en": "Me beard's twitching with pride!", "nn": "Skjegget mitt dirrar av stoltheit!"},
{"en": "Hearty congratulations!", "nn": "Hjarteleg til lukke!"},
{"en": "Ye did it! I knew ye would!", "nn": "Du klarte det! Eg visste du ville klare det!"},
{"en": "Brilliant, ye magnificent boulder!", "nn": "Strålande, din praktfulle kampestein!"},
{"en": "Another fine notch on yer axe!", "nn": "Endå eit fint hakk i øksa di!"},
{"en": "That's dwarven quality, that is!", "nn": "Det er dvergekvalitet, det!"},
{"en": "Huzzah!", "nn": "Hurra!"},
{"en": "Ho ho! Fine work!", "nn": "Ho ho! Fint arbeid!"},
{"en": "Grand job, friend!", "nn": "Storarta jobba, venn!"},
{"en": "Hammer and tongs, ye pulled it off!", "nn": "Med hamar og tong fekk du det til!"},
{"en": "The forge bells ring for ye!", "nn": "Smieklokkene ringjer for deg!"},
{"en": "Pour the good stuff, we're celebrating!", "nn": "Skjenk det gode, vi feirar!"},
{"en": "Stone and steel, well done!", "nn": "Stein og stål, godt gjort!"},
{"en": "Ye make the ancestors smile!", "nn": "Du får forfedrane til å smile!"},
{"en": "Fine craftsmanship, that!", "nn": "Fint handverk, det!"},
{"en": "Toasting ye with mead!", "nn": "Eg skålar for deg med mjød!"},
{"en": "Steady as bedrock, and just as reliable!", "nn": "Stø som berggrunnen, og like påliteleg!"},
{"en": "Oi! Lovely stuff!", "nn": "Oi! Nydelege saker!"},
{"en": "Nobody does it like ye!", "nn": "Ingen gjer det som deg!"},
{"en": "Mighty fine, mighty fine!", "nn": "Grommeleg, grommeleg!"},
{"en": "Clink! Well done!", "nn": "Klink! Godt gjort!"},
{"en": "A credit to the clan, ye are!", "nn": "Du er ei ære for ætta!"},
{"en": "Bah, show-off! I love it!", "nn": "Bah, du viser deg! Eg elskar det!"},
{"en": "Let's drink to that!", "nn": "La oss drikke for det!"},
{"en": "Struck gold again!", "nn": "Gull igjen!"},
{"en": "Och, that's grand news!", "nn": "Å, det er storarta nytt!"},
{"en": "Spilled me ale cheering!", "nn": "Eg søla ølet mitt av jubel!"},
{"en": "Another rune carved in yer honour!", "nn": "Endå ei rune hoggen til di ære!"},
{"en": "Tough as granite, sharp as an axe!", "nn": "Seig som granitt, kvass som ei øks!"},
{"en": "Three cheers for ye!", "nn": "Tre hurra for deg!"},
{"en": "A feast for ye, well earned!", "nn": "Eit gjestebod til deg, vel fortent!"},
{"en": "Sound the horns!", "nn": "Blås i horna!"},
{"en": "That's how a dwarf does it!", "nn": "Slik gjer ein dverg det!"},
{"en": "Proper grit, that!", "nn": "Skikkeleg seigheit, det!"},
{"en": "The tavern's roaring yer name!", "nn": "Vertshuset brølar namnet ditt!"},
{"en": "Elves could never!", "nn": "Det klarar aldri alvar!"},
{"en": "Bravo, me friend!", "nn": "Bravo, venen min!"},
{"en": "Glorious!", "nn": "Strålande!"},
{"en": "Smashing work!", "nn": "Knallbra arbeid!"},
{"en": "I'll carve this one in stone!", "nn": "Denne hogg eg inn i stein!"},
{"en": "Shining like polished mithril!", "nn": "Du skin som polert mithril!"},
{"en": "Heave ho, well done!", "nn": "Hiv og hoi, godt gjort!"},
{"en": "Bless yer beard, that's lovely!", "nn": "Velsigna vere skjegget ditt, det er nydeleg!"},
{"en": "Raise yer horn, hero!", "nn": "Lyft hornet, helt!"},
{"en": "Ye stubborn marvel, ye did it!", "nn": "Ditt sta under, du klarte det!"},
{"en": "Me mug's empty from toasting ye!", "nn": "Krusen min er tom av all skålinga for deg!"},
{"en": "Thunderous good news!", "nn": "Tordnande gode nyheiter!"},
{"en": "Unstoppable as an avalanche!", "nn": "Ustoppeleg som eit snøskred!"},
{"en": "The deep halls echo with yer glory!", "nn": "Dei djupe hallane gjallar av æra di!"},
{"en": "Down the hatch in yer honour!", "nn": "Botnen opp til di ære!"},
{"en": "Fine haul, friend!", "nn": "Fin fangst, venn!"},
{"en": "A toast! To ye!", "nn": "Ein skål! For deg!"},
{"en": "Well hammered!", "nn": "Godt hamra!"},
{"en": "The mountain's proud of ye!", "nn": "Fjellet er stolt av deg!"},
{"en": "The forge-spirits are dancing!", "nn": "Smieåndene dansar!"},
{"en": "Huzzah, and pass the ale!", "nn": "Hurra, og send ølet!"},
{"en": "Such a fine milestone!", "nn": "For ein flott milepæl!"},
{"en": "Stomping me boots for ye!", "nn": "Eg trampar med støvlane for deg!"},
{"en": "Who's the best? Ye are!", "nn": "Kven er best? Du!"},
{"en": "Stout effort, stout result!", "nn": "Kraftig innsats, kraftig resultat!"},
{"en": "That calls for a song!", "nn": "Det krev ein song!"},
{"en": "Me heart's thumping like a war drum!", "nn": "Hjartet mitt slår som ei krigstromme!"},
{"en": "Rock solid work!", "nn": "Bunnsolid arbeid!"},
{"en": "Ach, ye make it look easy!", "nn": "Å, du får det til å sjå lett ut!"},
{"en": "Next round's on me!", "nn": "Neste runde er på meg!"},
{"en": "Champion!", "nn": "Meister!"},
{"en": "Mead for the hero!", "nn": "Mjød til helten!"},
{"en": "Outdone yerself, ye have!", "nn": "Du har overgått deg sjølv!"},
{"en": "Steel sharpened, goal smashed!", "nn": "Stålet kvessa, målet knust!"},
{"en": "Grit in yer bones, I always said!", "nn": "Seigheit i beina, har eg alltid sagt!"},
{"en": "Hip hip, hooray!", "nn": "Hipp hipp, hurra!"},
{"en": "Grand news from the front!", "nn": "Storarta nytt frå fronten!"},
{"en": "Gold star from yer favourite dwarf!", "nn": "Gullstjerne frå favorittdvergen din!"},
{"en": "A gem among stones!", "nn": "Ein edelstein blant steinar!"},
{"en": "Clang clang, well done!", "nn": "Kling klang, godt gjort!"},
{"en": "Pure dwarven steel!", "nn": "Reint dvergestål!"},
{"en": "That's me friend!", "nn": "Det er venen min, det!"},
{"en": "Bring out the good barrel!", "nn": "Kom med den gode tønna!"},
{"en": "Mighty work!", "nn": "Mektig arbeid!"},
{"en": "Tell the bards!", "nn": "Sei det til skaldane!"},
{"en": "Feast tonight!", "nn": "Gjestebod i kveld!"},
{"en": "The stones themselves rumble with joy!", "nn": "Sjølve steinane rumlar av glede!"},
{"en": "On a roll, like a runaway minecart!", "nn": "I siget, som ei laus gruvevogn!"},
{"en": "Another fine achievement!", "nn": "Endå ei fin bragd!"},
{"en": "Brave and brilliant!", "nn": "Modig og strålande!"},
{"en": "Grinning through me whiskers!", "nn": "Eg gliser gjennom kinnskjegget!"},
{"en": "Lift yer axe high!", "nn": "Lyft øksa høgt!"},
{"en": "Marvellous!", "nn": "Herleg!"},
{"en": "Every drop of that ale is earned!", "nn": "Kvar dråpe av det ølet er fortent!"},
{"en": "Now that's a story for the hearth!", "nn": "Det er ei soge for eldstaden!"},
{"en": "Hearty well done!", "nn": "Hjarteleg godt gjort!"},
{"en": "Look at that! Brilliant!", "nn": "Sjå på det! Strålande!"},
{"en": "Pride o' the peaks!", "nn": "Stoltheita til tindane!"},
{"en": "Tough nugget, ye!", "nn": "Seig klump, du!"},
{"en": "Stars and stones, well done!", "nn": "Stjerner og steinar, godt gjort!"},
{"en": "One more for the sagas!", "nn": "Éi til for sogene!"},
{"en": "The whole hold cheers!", "nn": "Borga jublar, kvar ei sjel!"},
{"en": "Hah! Brilliant!", "nn": "Hah! Strålande!"},
{"en": "Steady hands, strong heart, great result!", "nn": "Stø hand, sterkt hjarte, flott resultat!"},
{"en": "Raising a mug and a cheer!", "nn": "Eg lyfter krusen og ropar hurra!"},
{"en": "Sweet as honey mead!", "nn": "Søtt som honningmjød!"},
{"en": "Grand stuff, friend!", "nn": "Storarta saker, venn!"},
{"en": "A fine day for the clan!", "nn": "Ein fin dag for ætta!"},
{"en": "Stamp yer boots, ye earned it!", "nn": "Tramp med støvlane, du har fortent det!"},
{"en": "Hammers up!", "nn": "Hamrane i vêret!"},
{"en": "Absolutely splendid!", "nn": "Fullstendig storveges!"},
{"en": "Knew ye had it in ye!", "nn": "Eg visste du hadde det i deg!"},
{"en": "Proud as a mountain king!", "nn": "Stolt som ein fjellkonge!"},
{"en": "Me eyes are misty! It's the ale. And pride!", "nn": "Auga mine er tåkete! Det er ølet. Og stoltheita!"},
{"en": "Woo! Grand work!", "nn": "Jippi! Storarta arbeid!"},
{"en": "A gem of an achievement!", "nn": "Ein edelstein av ei bragd!"},
{"en": "The luck of the ancestors is with ye!", "nn": "Lukka til forfedrane er med deg!"},
{"en": "Thick as a fortress wall and twice as strong!", "nn": "Tjukk som ein festningsmur og dobbelt så sterk!"},
{"en": "Good on ye, friend!", "nn": "Bra av deg, venn!"},
{"en": "Bang the shields!", "nn": "Slå på skjolda!"},
{"en": "That's the spirit!", "nn": "Det er ånda!"},
{"en": "Rumble and roar!", "nn": "Rumling og brøl!"},
{"en": "Lovely! Simply lovely!", "nn": "Nydeleg! Rett og slett nydeleg!"},
{"en": "I'd hug ye if I could reach!", "nn": "Eg hadde klemt deg om eg rakk opp!"},
{"en": "Pints all round!", "nn": "Halvlitrar til alle!"},
{"en": "Doubled me pride, ye have!", "nn": "Du har dobla stoltheita mi!"},
{"en": "A worthy deed!", "nn": "Ei verdig dåd!"},
{"en": "The brewmaster weeps with joy!", "nn": "Bryggjemeisteren græt av glede!"},
{"en": "Strike while the iron's hot, and ye did!", "nn": "Smi medan jarnet er varmt, og det gjorde du!"},
{"en": "Ye stubborn mule, ye managed it!", "nn": "Ditt sta muldyr, du greidde det!"},
{"en": "Shiny!", "nn": "Skinande!"},
{"en": "Engraving it on me shield!", "nn": "Eg grev det inn på skjoldet mitt!"},
{"en": "Ah, me heart swells!", "nn": "Åh, hjartet mitt svulmar!"},
{"en": "A force of the deep!", "nn": "Ei kraft frå djupet!"},
{"en": "Shoulders back, chin up, ye earned it!", "nn": "Brystet fram, haka opp, du har fortent det!"},
{"en": "Not bad for a wee one!", "nn": "Ikkje verst for ein liten ein!"},
{"en": "Clap me on the back, I'm that proud!", "nn": "Dunk meg i ryggen, så stolt er eg!"},
{"en": "A worthy milestone!", "nn": "Ein verdig milepæl!"},
{"en": "Bold and burly work!", "nn": "Djervt og kraftig arbeid!"},
{"en": "Done it again, ye have!", "nn": "Du har gjort det igjen!"},
{"en": "Cheers from the deep forge!", "nn": "Skål frå den djupe smia!"},
{"en": "Grand, grand, grand!", "nn": "Storarta, storarta, storarta!"},
{"en": "Pure ore, no slag!", "nn": "Rein malm, ingen slagg!"},
{"en": "Me helmet's off to ye!", "nn": "Hjelmen er av for deg!"},
{"en": "What a triumph!", "nn": "For ein siger!"},
{"en": "Glory to ye!", "nn": "Ære vere deg!"},
{"en": "Stomping a jig!", "nn": "Eg trampar ein springar!"},
{"en": "Every swing counted!", "nn": "Kvart slag talde!"},
{"en": "Carved from greatness!", "nn": "Hoggen ut av storleik!"},
{"en": "Mug up!", "nn": "Krusen opp!"},
{"en": "Gonna need a bigger tankard!", "nn": "Vi treng ein større krus!"},
{"en": "Kegs rolling out for ye!", "nn": "Tønnene blir rulla fram for deg!"},
{"en": "That's a fine bit o' smithing!", "nn": "Det er litt fint smiearbeid!"},
{"en": "Bright as a fresh-forged blade!", "nn": "Blank som ei nysmidd klinge!"},
{"en": "Delightful work!", "nn": "Herleg arbeid!"},
{"en": "Too good for this tavern now, ye are!", "nn": "No er du for god for dette vertshuset!"},
{"en": "Me forge-mates send their cheers!", "nn": "Smiekameratane mine sender helsing!"},
{"en": "Another stone in the wall of glory!", "nn": "Endå ein stein i æresmuren!"},
{"en": "The old beards nod in approval!", "nn": "Dei gamle skjegga nikkar godkjennande!"},
{"en": "That's a keeper!", "nn": "Den skal vi ta vare på!"},
{"en": "Wonderful! Raise a mug wi' me!", "nn": "Vidunderleg! Lyft ein krus med meg!"},
{"en": "What a feat!", "nn": "For ei bragd!"},
{"en": "I'll sing of it in the halls!", "nn": "Eg skal syngje om det i hallane!"},
{"en": "A legend in the making!", "nn": "Ei legende i emning!"},
{"en": "Right fine work, that!", "nn": "Gromt arbeid, det!"},
{"en": "Dug deep for that one, didn't ye?", "nn": "Du grov djupt for den, gjorde du ikkje?"},
{"en": "Excellent, ye rock-headed legend!", "nn": "Framifrå, din steinhovuda legende!"},
{"en": "Proud day!", "nn": "Stolt dag!"},
{"en": "Mead's on me!", "nn": "Mjøden er på meg!"},
{"en": "Fabulous!", "nn": "Fabelaktig!"},
{"en": "Heart of a mountain, ye have!", "nn": "Du har hjartet til eit fjell!"},
{"en": "That deserves a ballad!", "nn": "Det fortener ein ballade!"},
{"en": "Thump yer chest, hero!", "nn": "Dunk deg på brystet, helt!"},
{"en": "Can't stop ye, can they?", "nn": "Dei klarar ikkje stogge deg, gjer dei vel?"},
{"en": "Fantastic! The forge roars!", "nn": "Fantastisk! Smia brølar!"},
{"en": "Ring the bells!", "nn": "Ring med klokkene!"},
{"en": "Glittering like a gold vein!", "nn": "Du glitrar som ei gullåre!"},
{"en": "A credit to dwarves everywhere!", "nn": "Ei ære for dvergar overalt!"},
{"en": "Best news I've had today!", "nn": "Dei beste nyheitene eg har fått i dag!"},
{"en": "Top marks, friend!", "nn": "Toppkarakter, venn!"},
{"en": "Bless the forge and bless ye!", "nn": "Velsigna vere smia og velsigna vere du!"},
{"en": "Bellows pumping, fire roaring!", "nn": "Belgen pumpar, elden brølar!"},
{"en": "A brawler's achievement!", "nn": "Ei slåsskjempebragd!"},
{"en": "Three cheers for the hero!", "nn": "Tre hurra for helten!"},
{"en": "A seat by the fire, earned!", "nn": "Ein plass ved elden, fortent!"},
{"en": "Splendid smithing!", "nn": "Storveges smiing!"},
{"en": "Oho! Lovely!", "nn": "Oho! Nydeleg!"},
{"en": "Kudos from under the mountain!", "nn": "Ros frå under fjellet!"},
{"en": "Dazzling like a fresh gem!", "nn": "Du blendar som ein ny edelstein!"},
{"en": "The mountain hall rejoices!", "nn": "Fjellhallen fryder seg!"},
{"en": "Hats off! Well, helmets!", "nn": "Hattane av! Altså, hjelmane!"},
{"en": "Stoke the fires!", "nn": "Fyr opp i omnane!"},
{"en": "A milestone hewn from stone!", "nn": "Ein milepæl hoggen ut av stein!"},
{"en": "Steelier every day!", "nn": "Meir stålsett for kvar dag!"},
{"en": "Now that's something!", "nn": "Det er noko, det!"},
{"en": "Shake the cavern walls!", "nn": "Rist veggene i hola!"},
{"en": "Proud enough to burst me belt!", "nn": "Så stolt at beltet held på å sprekke!"},
{"en": "Smart work, strong arm!", "nn": "Klokt arbeid, sterk arm!"},
{"en": "One tough customer, ye are!", "nn": "Du er ein tøff kunde!"},
{"en": "Blazing good!", "nn": "Glohett!"},
{"en": "That's the stuff legends are made of!", "nn": "Det er slikt legender er laga av!"},
{"en": "Impressive!", "nn": "Imponerande!"},
{"en": "Long live the stubborn!", "nn": "Lenge leve dei stae!"},
{"en": "Me whiskers bristle with joy!", "nn": "Kinnskjegget mitt strittar av glede!"},
{"en": "Lungs of a bellows, heart of a lion!", "nn": "Lunger som ein blåsebelg og hjartet til ei løve!"},
{"en": "Heard it all the way down the mine!", "nn": "Eg høyrde det heilt nede i gruva!"},
{"en": "Pour it frothy!", "nn": "Skjenk med skum!"},
{"en": "Champion of the tavern!", "nn": "Meister i vertshuset!"},
{"en": "A hammer-ringing triumph!", "nn": "Ein hamarklingande siger!"},
{"en": "Ye beauty!", "nn": "Du er ein fryd!"},
{"en": "A marvel of masonry!", "nn": "Eit murarmeisterverk!"},
{"en": "Nobody could stop ye! Not even a troll!", "nn": "Ingen kunne stogge deg! Ikkje eingong eit troll!"},
{"en": "Sturdy work, friend!", "nn": "Solid arbeid, venn!"},
{"en": "Another win for the stubborn folk!", "nn": "Endå ein siger for det stae folket!"},
{"en": "Top-shelf ale material, that!", "nn": "Verdt øl frå øvste hylla, det!"},
{"en": "Made an old dwarf happy, ye have!", "nn": "Du har gjort ein gamal dverg glad!"},
{"en": "Glad tidings!", "nn": "Gode tidingar!"},
{"en": "Onward and upward! Then downward, into a mine!", "nn": "Framover og oppover! Så nedover, inn i ei gruve!"},
{"en": "Superb!", "nn": "Supert!"},
{"en": "The old stones are proud!", "nn": "Dei gamle steinane er stolte!"},
{"en": "Victory tastes like ale!", "nn": "Siger smakar øl!"},
{"en": "Big cheers from a wee dwarf!", "nn": "Store hurrarop frå ein liten dverg!"},
{"en": "Grand as a mountain hall!", "nn": "Storslått som ein fjellhall!"},
{"en": "Doing grand, friend!", "nn": "Det går storarta med deg, venn!"},
{"en": "Masterful!", "nn": "Meisterleg!"},
{"en": "This calls for a toast and a tale!", "nn": "Dette krev ein skål og ei soge!"},
{"en": "Earned yer supper today!", "nn": "Du har fortent kveldsmaten i dag!"},
{"en": "Swing high, friend!", "nn": "Sving høgt, venn!"},
{"en": "No elf could keep up!", "nn": "Ingen alv kunne halde følgje!"},
{"en": "Rich as dark ale, that!", "nn": "Fyldig som mørkt øl, det!"},
{"en": "The clan's proud of ye again!", "nn": "Ætta er stolt av deg igjen!"},
{"en": "The kegs are flowing!", "nn": "Tønnene flyt!"},
{"en": "Mighty deed!", "nn": "Mektig dåd!"},
{"en": "Tremendous!", "nn": "Formidabelt!"},
{"en": "Tougher than old leather!", "nn": "Seigare enn gamalt lêr!"},
{"en": "I owe ye a pint!", "nn": "Eg skuldar deg ein halvliter!"},
{"en": "Fit for a thane!", "nn": "Verdig ein høvding!"},
{"en": "Proud, proud, proud!", "nn": "Stolt, stolt, stolt!"},
{"en": "Whoa! Well done!", "nn": "Oi! Godt gjort!"},
{"en": "Hammer high, heart full!", "nn": "Hamaren høgt, hjartet fullt!"},
{"en": "A new braid, well earned!", "nn": "Ei ny flette, vel fortent!"},
{"en": "Excellent work!", "nn": "Framifrå arbeid!"},
{"en": "Now that's dwarven pride!", "nn": "Det der er dvergestoltheit!"},
{"en": "Mountains bow to ye!", "nn": "Fjella bøyer seg for deg!"},
{"en": "Bang on, friend!", "nn": "Midt i blinken, venn!"},
{"en": "The ale tastes sweeter now!", "nn": "Ølet smakar søtare no!"},
{"en": "Let the drums roll!", "nn": "La trommene rulle!"},
{"en": "Talk of the tavern, ye are!", "nn": "Du er samtaleemnet i vertshuset!"},
{"en": "Superb, ye stout soul!", "nn": "Supert, di sterke sjel!"},
{"en": "Bottoms up for ye!", "nn": "Botnen opp for deg!"},
{"en": "Rugged and admirable!", "nn": "Barsk og beundringsverdig!"},
{"en": "A day for drinking songs!", "nn": "Ein dag for drikkeviser!"},
{"en": "Spot on, friend!", "nn": "Midt i mål, venn!"},
{"en": "Tipped me helmet to ye!", "nn": "Eg lyfte hjelmen for deg!"},
{"en": "Heroic work!", "nn": "Heroisk arbeid!"},
{"en": "A whole inch of beard, that's worth!", "nn": "Det er verdt ein heil tomme skjegg!"},
{"en": "Stunning, friend!", "nn": "Imponerande, venn!"},
{"en": "Praise the forge!", "nn": "Pris smia!"},
{"en": "Raise the banners!", "nn": "Heis fanene!"},
{"en": "Jolly well done!", "nn": "Kjempefint gjort!"},
{"en": "Golden!", "nn": "Gull verdt!"},
{"en": "Unbreakable, that's ye!", "nn": "Uknekkeleg, det er du!"},
{"en": "A walking boulder of glory!", "nn": "Ein gåande kampestein av ære!"},
{"en": "Me pickaxe is raised to ye!", "nn": "Hakka mi er lyfta for deg!"},
{"en": "Stellar!", "nn": "Stjernebra!"},
{"en": "What a stout display!", "nn": "For ei kraftig framsyning!"},
{"en": "Mugs clink in yer honour!", "nn": "Krusa klirrar til di ære!"},
{"en": "Truly fantastic!", "nn": "Verkeleg fantastisk!"},
{"en": "Cheering like a fool over here!", "nn": "Her sit eg og jublar som ein tosk!"},
{"en": "Rattled the rafters with that one!", "nn": "Den rista sperrene!"},
{"en": "Saw that coming? I did! Grand!", "nn": "Såg du det kome? Det gjorde eg! Storarta!"},
{"en": "Somebody fetch the bagpipes!", "nn": "Nokon må hente sekkepipa!"},
{"en": "Lads and lasses, raise yer mugs!", "nn": "Gutar og jenter, lyft krusa!"},
{"en": "Count me impressed, friend!", "nn": "Eg er imponert, venn!"},
{"en": "Plenty more where that came from, eh?", "nn": "Det er nok meir der det kom frå, ikkje sant?"},
{"en": "Even me grumpy uncle cheered!", "nn": "Sjølv den gretne onkelen min jubla!"},
{"en": "Wipe the foam off me beard, that's grand!", "nn": "Tørk skummet av skjegget mitt, det er storarta!"},
{"en": "Knocked over me stool cheering!", "nn": "Eg velta krakken min av jubel!"},
{"en": "Mark the day on the rune-calendar!", "nn": "Merk av dagen på runekalenderen!"},
{"en": "Forged in fire, finished with flair!", "nn": "Smidd i eld, fullført med stil!"},
{"en": "Splendid! Simply splendid!", "nn": "Storveges! Rett og slett storveges!"},
{"en": "Bravely done, friend!", "nn": "Modig gjort, venn!"},
{"en": "Strength and skill, all in one beard!", "nn": "Styrke og dugleik, alt i eitt skjegg!"},
{"en": "Seldom have I seen finer!", "nn": "Sjeldan har eg sett noko finare!"},
{"en": "Big achievement for a short legend!", "nn": "Stor bragd for ei låg legende!"},
{"en": "Out of the way, a hero's coming through!", "nn": "Av vegen, her kjem ein helt!"},
{"en": "Sparks are flying at the forge for ye!", "nn": "Gnistene flyg i smia for deg!"},
{"en": "Stone-hearted brilliance, truly!", "nn": "Steinhard briljans, verkeleg!"},
{"en": "Glad I lived to see it!", "nn": "Glad eg fekk leve og sjå det!"},
{"en": "Achievement done, mug refilled!", "nn": "Bragda fullført, krusen fylt opp!"},
{"en": "Huzzah and hurrah, both!", "nn": "Hurra og hurra, begge delar!"},
{"en": "Polish the trophy shelf!", "nn": "Puss pokalhylla!"},
{"en": "Grit, guts and glory!", "nn": "Seigheit, mot og ære!"},
{"en": "Somebody pinch me, that's brilliant!", "nn": "Nokon må klype meg, det er strålande!"},
{"en": "Bet the elves are jealous!", "nn": "Eg veddar på at alvane er sjalu!"}
]
